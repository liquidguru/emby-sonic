<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>EmbysonicPlugin</AssemblyName>
    <RootNamespace>EmbysonicPlugin</RootNamespace>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>0.4.5.0</AssemblyVersion>
    <FileVersion>0.4.5.0</FileVersion>
  </PropertyGroup>

  <!-- Emby SDK DLLs — copy from an Emby installation into plugin/lib/
       Windows: %APPDATA%\Emby-Server\system\MediaBrowser.*.dll
       Linux:   /opt/emby-server/system/MediaBrowser.*.dll

       IMPORTANT — build against the OLDEST Emby you want to support, not your own.
       .NET assembly binding only resolves "upward": a plugin built against, say,
       4.8.x loads on 4.8 AND every newer server (4.9, 4.10, …). Built against a
       NEWER SDK than the user's server, Emby silently skips the plugin (it never
       appears on the Plugins page). The shipped beta builds use the 4.8.11.0 SDK
       so they load on the stable 4.8/4.9 lines and the 4.10 beta alike.
       Stable releases: https://github.com/MediaBrowser/Emby.Releases/releases -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MediaBrowser.Common">
      <HintPath>lib\MediaBrowser.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Controller">
      <HintPath>lib\MediaBrowser.Controller.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Model">
      <HintPath>lib\MediaBrowser.Model.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.js" />
    <EmbeddedResource Include="thumb.png" />
  </ItemGroup>

</Project>
