# Optional: Emby's publicly-reachable address (FQDN/reverse proxy), only
# needed if you use the web app from outside your LAN. Leave blank otherwise.
EMBY_URL_EXTERNAL=
# The Emby server's address as reachable FROM the machine running the
# coordinator. If Emby runs on that same machine, http://localhost:8096 works.
EMBY_URL=http://localhost:8096
EMBY_API_KEY=your_emby_api_key_here
WORKER_SECRET=change_me_for_worker_routes
AUTH_CACHE_TTL_SECONDS=30
AUTH_CACHE_MAX_ENTRIES=1024

HOST=0.0.0.0
PORT=8765

DATA_DIR=data
MODEL_DIR=models

EMBEDDING_MODEL=PANNs-CNN14
EMBEDDING_DIM=128
