# Optional: Emby's publicly-reachable address (FQDN/reverse proxy), only
# needed if you use the web app from outside your LAN. Leave blank otherwise.
EMBY_URL_EXTERNAL=
# Your Emby server's address. Use the LAN address (e.g. http://192.168.1.10:8096)
# even if Emby runs on the same machine as the coordinator — do NOT use
# localhost/127.0.0.1. The web app hands this address to the browser to fetch
# music directly, so a loopback address makes every browser look for Emby on
# itself: you can log in fine, but your library shows up empty.
EMBY_URL=http://192.168.1.10:8096
EMBY_API_KEY=your_emby_api_key_here
WORKER_SECRET=change_me_for_worker_routes
AUTH_CACHE_TTL_SECONDS=30
AUTH_CACHE_MAX_ENTRIES=1024

HOST=0.0.0.0
PORT=8765

DATA_DIR=data
MODEL_DIR=models

EMBEDDING_MODEL=PANNs-CNN14
EMBEDDING_DIM=128
